{
  "name": "miblo-relay",
  "version": "1.2.0",
  "private": true,
  "description": "Self-hostable Miblo phone relay: end-to-end encrypted rooms, the phone registry and the Miblo phone app (PWA).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23 || >=23.4"
  },
  "scripts": {
    "build": "npm run build:app && npm run build:server",
    "build:app": "vite build --config app/vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "dev": "npm run build && MIBLO_RELAY_DEV=1 PUBLIC_ORIGIN=http://localhost:8787 node dist/server.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "typecheck": "tsc --noEmit",
    "hashes": "node scripts/hashes.mjs",
    "cf:secrets": "node scripts/cf-secrets.mjs"
  },
  "dependencies": {
    "ws": "8.21.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.25.4",
    "miniflare": "5.20261001.0-alpha",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
